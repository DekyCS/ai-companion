{
  "name": "khina",
  "version": "0.1.0",
  "private": true,
  "description": "Khina the hedgehog: an autonomous little guy who lives in a forest village.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "day": "node --env-file-if-exists=.env src/cli.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "tsc --noEmit && tsc --noEmit -p web",
    "long": "node --env-file-if-exists=.env src/long.ts",
    "copies": "node --env-file-if-exists=.env src/copies.ts",
    "layout": "node src/layout-json.ts",
    "art": "node src/layout-json.ts && /Applications/Blender.app/Contents/MacOS/Blender --background --python art/khina.py && /Applications/Blender.app/Contents/MacOS/Blender --background --python art/village.py",
    "live": "node --env-file-if-exists=.env src/live.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.181.0",
    "typescript": "^7.0.2"
  }
}
